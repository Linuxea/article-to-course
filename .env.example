# LLM provider (OpenAI-compatible). Examples:
#   DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-v4-flash
#   OpenAI:    LLM_BASE_URL=https://api.openai.com/v1     LLM_MODEL=gpt-4o-mini
#   Ollama:    LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=qwen2.5:7b   LLM_JSON_MODE=false
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# Leave LLM_API_KEY empty OR set LLM_MOCK=true to run without an LLM (uses a local mock).
# LLM_MOCK=false

# How many sections to generate in parallel.
# CONCURRENCY=3

# Max tokens per LLM call. Reasoning models (e.g. deepseek-v4-flash) burn several
# thousand tokens on reasoning alone — keep this generous or responses may come back empty.
# LLM_MAX_OUTPUT_TOKENS=16000

# Per-request timeout in ms. Reasoning models routinely need 2-4 minutes per call.
# LLM_TIMEOUT_MS=300000

# Structured generation via response_format json_schema. OFF by default because
# DeepSeek's official API does not support json_schema (400 error) and its
# json_object mode often returns EMPTY content for reasoning models. The pipeline
# then uses plain-text generation + local Zod validation instead (equally reliable,
# and avoids the empty-response quirk). Enable only when your endpoint truly
# supports OpenAI json_schema structured outputs (e.g. OpenAI, DeepInfra, Nebius).
# LLM_STRUCTURED_OUTPUT=false

# The AI SDK logs a benign "responseFormat is not supported" warning if structured
# output is enabled on an endpoint without json_schema support. Silence it with:
# AI_SDK_LOG_WARNINGS=false

# Server port.
# PORT=3000
